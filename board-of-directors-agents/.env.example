# Board of Directors Agents Configuration

# Optional: OpenAI API Key (leave empty to use Ollama by default)
OPENAI_API_KEY=

# Optional: Custom Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Default model override
BOARD_MODEL=llama2

# Optional: Enable debug logging
DEBUG=false

# Optional: Custom blog index file path
BLOG_INDEX_PATH=resources/blog_index.yml
